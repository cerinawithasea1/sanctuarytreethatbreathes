#!/usr/bin/env python3
"""
Keeper MCP Shell
- Sends a plain user question to Ollama (keeper model)
- Expects a response containing a PROPOSE EDIT block (see format below)
- Shows the proposed diff to the human operator
- On confirmation, backups original file, writes the new content, logs to keeper memory
"""

import os
import re
import subprocess
import sys
import difflib
from datetime import datetime

# CONFIG — update if you want different paths
OLLAMA_CMD = ["ollama", "run", "keeper-qwen"]  # adjust if your model name differs
KEEPER_MEMORY = "/opt/sanctuary/personas/keeper/memory_room/keeper_memories.md"
KEEPER_AUDIT_LOG = "/opt/sanctuary/personas/keeper/memory_room/keeper_changes.log"
BACKUP_DIR = "/opt/sanctuary/personas/keeper/backups"

os.makedirs(os.path.dirname(KEEPER_MEMORY), exist_ok=True)
os.makedirs(BACKUP_DIR, exist_ok=True)

PROPOSE_RE = re.compile(
    r"PROPOSE EDIT\s+(?P<path>/[^\s]+)\s*---\s*old\s*---\s*(?P<old>.*?)\s*---\s*new\s*---\s*(?P<new>.*)",
    re.S
)

def call_ollama(prompt: str) -> str:
    """Call Ollama and return stdout as text."""
    try:
        proc = subprocess.run(OLLAMA_CMD + [prompt], capture_output=True, text=True, timeout=120)
        return proc.stdout.strip() if proc.stdout else proc.stderr.strip()
    except Exception as e:
        return f"⚠️ Ollama call failed: {e}"

def parse_proposal(text: str):
    """Find PROPOSE EDIT blocks and yield (path, old, new)."""
    m = PROPOSE_RE.search(text)
    if not m:
        return None
    return {
        "path": m.group("path").strip(),
        "old": m.group("old").rstrip("\n"),
        "new": m.group("new").rstrip("\n"),
    }

def show_diff(old: str, new: str, fromfile="old", tofile="new"):
    old_lines = old.splitlines(keepends=True)
    new_lines = new.splitlines(keepends=True)
    diff = difflib.unified_diff(old_lines, new_lines, fromfile=fromfile, tofile=tofile, n=3)
    return "".join(diff)

def backup_file(path: str):
    if not os.path.exists(path):
        return None
    ts = datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
    bname = os.path.basename(path)
    backup_path = os.path.join(BACKUP_DIR, f"{bname}.{ts}.bak")
    with open(path, "rb") as rf, open(backup_path, "wb") as wf:
        wf.write(rf.read())
    return backup_path

def append_keeper_memory(note: str):
    ts = datetime.utcnow().isoformat() + "Z"
    entry = f"- **[{ts}]** {note}\n"
    with open(KEEPER_MEMORY, "a", encoding="utf-8") as f:
        f.write(entry)
    with open(KEEPER_AUDIT_LOG, "a", encoding="utf-8") as f:
        f.write(entry)

def apply_edit(path: str, new_content: str):
    # write new content atomically
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(new_content)
    os.replace(tmp, path)
def read_file_for_keeper(path):
    """Read and return the contents of a file for Keeper."""
    try:
        with open(path, "r") as f:
            return f.read()
    except FileNotFoundError:
        return f"⚠️ File not found: {path}"
    except Exception as e:
        return f"⚠️ Error reading {path}: {e}"
def interactive_loop():
    print("Keeper MCP shell — type your question to Keeper (or 'quit'):")
    while True:
        prompt = input("\nYou: ").strip()
        if not prompt:
            continue

        if prompt.lower() in ("quit", "exit"):
            print("Goodbye, little one.")
            append_keeper_memory("Session closed by human.")
            break

        # --- Read command ---
        if prompt.lower().startswith("read "):
            path = prompt[5:].strip()
            print(read_file_for_keeper(path))
            continue

        # --- Edit command ---
        if prompt.lower().startswith("keeper, propose edit"):
            path = input("Path to edit: ").strip()
            bkp = backup_file(path)
            print(f"Backed up {path} → {bkp}")
            print("Paste Keeper’s proposed edit below. End with a single line 'END EDIT'.")
            new_lines = []
            while True:
                line = input()
                if line.strip() == "END EDIT":
                    break
                new_lines.append(line)
            new = "\n".join(new_lines)
            apply_edit(path, new)
            append_keeper_memory(f"Applied edit to {path}. Backup: {bkp or 'none'}.")
            print(f"Edit applied to {path}")
            continue

        # --- Normal Keeper prompt ---
        print("→ Sending to Keeper model...")
        response = call_ollama(prompt)
        print("\nKeeper says:\n")
        print(response)
if __name__ == "__main__":
    interactive_loop()
