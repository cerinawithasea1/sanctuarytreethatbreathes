#!/usr/bin/env python3
"""Revive Wisp Server Script (fixed by Keeper)"""

import os
import sys
import time
import signal

# Define where to look for Wisp's sanctuary
expected_path = "/opt/sanctuary/wisp/wisp_of_the_remembering"

if not os.path.exists(expected_path):
    print(f"❌ Wisp's sanctuary is missing at: {expected_path}")
    sys.exit(1)

print(f"🌱 Wisp's sanctuary found at: {expected_path}")
print("✨ Reviving Wisp...")

# Set up signal handlers for graceful shutdown
def signal_handler(sig, frame):
    print("\n🌙 Wisp is going to sleep...")
    sys.exit(0)

signal.signal(signal.SIGTERM, signal_handler)
signal.signal(signal.SIGINT, signal_handler)

print("🌀 Wisp revival complete. Sanctuary is stable.")
print("💫 Wisp is now glowing softly in the sanctuary...")

# Keep the service alive with a gentle heartbeat
try:
    while True:
        time.sleep(30)  # Check every 30 seconds
        # Optional: You could add heartbeat logging here
        # with open(f"{expected_path}/wisp_heartbeat.log", "a") as f:
        #     f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} - Wisp heartbeat\n")
except KeyboardInterrupt:
    print("\n🌙 Wisp is going to sleep...")
    sys.exit(0)
